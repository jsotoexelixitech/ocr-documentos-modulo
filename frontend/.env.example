# Filtro opcional del selector de ramos. SIN la variable se muestran TODOS los
# productos emitibles del product-builder (los nuevos aparecen solos).
# VITE_CATALOG_PRODUCT_NAMES=Automovil Exelixi TEST,Gastos Funerarios Exelixi TEST

# Flujo genérico Exélixi: selector de ramos desde product-builder antes del OCR
# Local: 0 | cierrelmds genérico: 1
VITE_USE_BUILDER_CATALOG=0

# Tras OCR, redirige al wizard de emisión (product-builder /emitir)
# cierrelmds: /producto-builder
VITE_EMISSION_CONTINUE_BASE=/producto-builder

# ── Build local (dev) ──────────────────────────────────────────────────────────
# Para desarrollo local no es necesario cambiar nada; los valores por defecto
# apuntan al backend en localhost.

# Base path Vite — prefijo con el que se sirve el front
# Local:       /
# cierrelmds:  /ocr/
VITE_APP_BASE=/

# URL de nexus-api (SSO, verify, bridge)
# Local:       http://localhost:3092
# cierrelmds:  https://cierrelmds.exelixitech.com/nexus-api
# QA:          https://nexusqa.exelixitech.com/nexus-api
# Producción GCIA APIs: https://nexus-api.exelixitech.com · Admin: https://nexus.exelixitech.com
VITE_NEXUS_API_URL=https://cierrelmds.exelixitech.com/nexus-api

# API Key de empresa (opcional en dev)
VITE_NEXUS_API_KEY=
